++++ b/src/pretalx/agenda/templates/agenda/schedule.html
+@@ -47,7 +47,7 @@
+         {% if schedule != schedule.event.current_schedule %}
+             <div class="m-3">
+                 {% #alert level="warning" %}
+-                {% if not schedule.version %}
++                {% if not schedule.published %}
+                     {{ phrases.schedule.wip_version }}
+                 {% else %}
+                     {{ phrases.schedule.old_version }}
