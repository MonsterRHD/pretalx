++        event, sub_type, window_a=(0, 60), window_b=(60, 120)
++    )
++    user = UserFactory()
++
++    with scope(event=event):
++        signup_a = create_signup(submission_a, user=user)
++        signup_b = create_signup(submission_b, user=user)
