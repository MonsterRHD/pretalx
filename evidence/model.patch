++            freeze_schedule(wip, "v2", notify_speakers=False)
++
++    conflicts = exc_info.value.conflicts
++    assert len(conflicts) == 1
++    assert {conflicts[0]["submission_a"], conflicts[0]["submission_b"]} == {
++        submission_a,
++        submission_b,
++    }
