++
++    with scopes_disabled():
++        release = (
++            ScheduleRelease.objects.select_related("event")
++            .filter(pk=release_id)
++            .first()
++        )
++    if not release or release.is_terminal:
++        return None
++    with scope(event=release.event):
++        advance_schedule_release(release_id)
++    return release_id
