+
+    def _has_new_score_options(self) -> bool:
+        return any(
+            self.cleaned_data.get(f"value_{label_id}") is not None
+            and self.cleaned_data.get(f"label_{label_id}")
+            for label_id in self.new_label_ids
+        )
 
     def clean(self):
         cleaned_data = super().clean()
